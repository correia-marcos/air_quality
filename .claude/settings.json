{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(/**)",
      "Bash(Rscript *)",
      "Bash(R -e *)",
      "Bash(R -q *)",
      "Bash(R --vanilla *)",
      "Bash(quarto *)",
      "Bash(make -n *)",
      "Bash(python3 -B -m unittest *)",
      "Bash(python3 -B tools/docs/check_links.py*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "WebSearch",
      "WebFetch(domain:cran.r-project.org)",
      "WebFetch(domain:rstudio.github.io)",
      "WebFetch(domain:r-spatial.github.io)",
      "WebFetch(domain:arrow.apache.org)",
      "WebFetch(domain:duckdb.org)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:learn.chatgpt.com)",
      "WebFetch(domain:developers.openai.com)",
      "mcp__context7__*",
      "mcp__deepwiki__*"
    ],
    "deny": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git am *)",
      "Bash(git commit-tree *)",
      "Bash(git update-ref *)",
      "Bash(git send-pack *)",
      "Bash(git fast-import *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git stash *)",
      "Bash(git clean *)",
      "Bash(git tag *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(docker *)",
      "Read(.env)",
      "Read(.Renviron)",
      "Read(.netrc)",
      "Read(**/.env)",
      "Read(**/.Renviron)",
      "Read(**/.netrc)",
      "Edit(renv.lock)",
      "Edit(data/raw/**)",
      "Edit(data/_legacy/**)",
      "Edit(data/downloads/**)",
      "Edit(.env)",
      "Edit(.Renviron)",
      "Edit(.netrc)",
      "Edit(**/.env)",
      "Edit(**/.Renviron)",
      "Edit(**/.netrc)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyWrite": ["./.git"]
    },
    "credentials": {
      "files": [
        { "path": "./.env", "mode": "deny" },
        { "path": "./.Renviron", "mode": "deny" },
        { "path": "./.netrc", "mode": "deny" },
        { "path": "~/.netrc", "mode": "deny" },
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.git-credentials", "mode": "deny" },
        { "path": "~/.config/gh", "mode": "deny" },
        { "path": "~/.codex/auth.json", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.docker", "mode": "deny" }
      ]
    }
  },
  "includeGitInstructions": false,
  "respectGitignore": true,
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
    "RENV_CONFIG_SANDBOX_ENABLED": "FALSE"
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rm -f \"${CLAUDE_PROJECT_DIR}/Rplots.pdf\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
